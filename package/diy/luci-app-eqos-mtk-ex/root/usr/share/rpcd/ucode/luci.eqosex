/**
 * luci.eqosex - EQoS queue monitor backend
 *
 * HNAT path only. Reads HQoS/QDMA queue statistics from debugfs
 * (/sys/kernel/debug/hnat) and reports per-queue usage plus real-time
 * rates (computed from cumulative counters between successive calls).
 *
 * The queue layout and the queue map are read from the state files the
 * helper script writes at start time (/var/run/eqosex.layout and
 * /var/run/eqosex.qidmap).  Probing the hardware from here is not an
 * option: reading a qdma_txq node clears its counters, so every layout
 * poll would steal a sampling window from the rate monitor.
 **/

'use strict';
import { readfile } from 'fs';

const HNAT_DIR = '/sys/kernel/debug/hnat';
const LAYOUT_FILE = '/var/run/eqosex.layout';
const MAP_FILE = '/var/run/eqosex.qidmap';

let last = null;

const read_trimmed = (p) => {
	let c = readfile(p);
	return c ? trim(c) : null;
};

/* split on whitespace, dropping empty fields */
const fields = (line) => {
	let raw = split(trim(line), ' '), out = [];

	for (let i = 0; i < length(raw); i++)
		if (length(raw[i]))
			push(out, raw[i]);

	return out;
};

/* "key value" lines */
const read_kv = (path) => {
	let out = {}, s = readfile(path);

	if (!s)
		return out;

	let lines = split(s, '\n');

	for (let i = 0; i < length(lines); i++) {
		let f = fields(lines[i]);
		if (length(f) >= 2)
			out[f[0]] = f[1];
	}

	return out;
};

/* parse per-queue qdma_txq%d nodes exposing "packet count"/"bytes count"
 * counters.  Reading one of these nodes clears it (the driver's MIB
 * read-and-clear behaviour), so the parsed numbers are the traffic
 * accumulated since the previous call, not a running total.
 *
 * The queue count doubles as the hardware probe: only the queues the driver
 * actually enabled exist, the rest are broken symlinks and read as null. */
const parse_qdma_tx = () => {
	let out = {};
	let count = 0;

	for (let i = 0; i < 64; i++) {
		let t = read_trimmed(HNAT_DIR + '/qdma_txq' + i);
		if (!t)
			continue;

		count = i + 1;

		let pm = match(t, /packet count:\s*(\d+)/);
		let bm = match(t, /bytes count:\s*(\d+)/);
		if (pm && bm)
			out[i] = { packets: int(pm[1]), bytes: int(bm[1]) };
	}
	return { queues: out, count: count };
};

/* Layout snapshot written by detect_qdma_layout(): which queues this SoC
 * exposed and where the pool ended up.  Without it (service never started)
 * fall back to "16 queues, short-packet queue reserved", the MT7981/MT7986
 * default, and mark the result as unconfirmed. */
const layout_info = () => {
	let kv = read_kv(LAYOUT_FILE);
	let qcount = kv.qcount ? int(kv.qcount) : 16;
	let first = kv.first ? int(kv.first) : 1;
	let last = kv.last ? int(kv.last) : (qcount - 2);
	let short_pkt = kv.short_pkt ? int(kv.short_pkt) : 1;
	let short_qid = kv.short_pkt_qid ? int(kv.short_pkt_qid) : (qcount - 1);

	return {
		confirmed: !!kv.qcount,
		qcount: qcount,
		first: first,
		last: last,
		short_pkt: short_pkt,
		short_pkt_qid: short_qid
	};
};

/* <identity> <dir> <qid> <rate-kbit>, one line per shaped direction. */
const parse_map = () => {
	let out = [], s = readfile(MAP_FILE);

	if (!s)
		return out;

	let lines = split(s, '\n');

	for (let i = 0; i < length(lines); i++) {
		let f = fields(lines[i]);
		if (length(f) < 4)
			continue;

		push(out, {
			key: f[0],
			dir: f[1],
			qid: int(f[2]),
			rate: int(f[3]),
			selector: f[0]
		});
	}

	return out;
};

/* Fold the per-direction lines into one record per rule.  A rule owns a
 * queue per shaped direction and nothing else ever shares it, so a record is
 * either a device row (identity is the client address) or a custom priority
 * rule (identity is "prio:<section>"). */
const build_groups = (entries) => {
	let index = {}, groups = [];

	for (let i = 0; i < length(entries); i++) {
		let e = entries[i];
		let g = index[e.key];

		if (!g) {
			let is_prio = substr(e.key, 0, 5) == 'prio:';

			g = {
				key: e.key,
				name: is_prio ? substr(e.key, 5) : e.key,
				shared: false,
				priority: is_prio,
				up: null,
				dl: null,
				members: [e.key]
			};
			index[e.key] = g;
			push(groups, g);
		}

		let slot = { qid: e.qid, rate: e.rate };
		if (e.dir == 'up')
			g.up = slot;
		else if (e.dir == 'dl')
			g.dl = slot;
	}

	return groups;
};

/* The software fallback no longer exists: a configuration that does not fit
 * the hardware is refused instead of being shaped with tc.  Kept as an empty
 * list so the status page has nothing to show and nothing to break. */
const parse_tc = () => [];

const pool_usage = (layout, entries) => {
	let used = {}, count = 0;

	for (let i = 0; i < length(entries); i++)
		if (!used[entries[i].qid]) {
			used[entries[i].qid] = true;
			count++;
		}

	let capacity = layout.last - layout.first + 1;
	let free = [];

	for (let q = layout.first; q <= layout.last; q++)
		if (!used[q])
			push(free, q);

	return {
		capacity: capacity > 0 ? capacity : 0,
		used: count,
		free: free,
		full: capacity > 0 && count >= capacity
	};
};

const methods = {
	getShortPkt: {
		call: function(req) {
			return {
				qos: read_trimmed(HNAT_DIR + '/short_pkt_toggle') || null,
				len: read_trimmed(HNAT_DIR + '/short_pkt_len') || null,
				qid: read_trimmed(HNAT_DIR + '/short_pkt_qid') || null,
				qos_toggle: read_trimmed(HNAT_DIR + '/qos_toggle') || null,
				path: 'hnat'
			};
		}
	},

	/* Queue map: which group owns which hardware queue, and what is left
	 * in the pool.  Used by the device table to show a group per row and
	 * by the capacity line above it. */
	getQueueMap: {
		call: function(req) {
			let layout = layout_info();
			let entries = parse_map();
			let groups = build_groups(entries);

			return {
				layout: layout,
				pool: pool_usage(layout, entries),
				groups: groups,
				tc: parse_tc()
			};
		}
	},

	getQueueStats: {
		call: function(req) {
			let parsed = parse_qdma_tx();
			let hq = parsed.queues;
			let has_counters = length(hq) > 0;

			let ck = clock();
			let now = ck[0] * 1000 + int(ck[1] / 1000000);
			let dt = last ? (now - last.time) / 1000 : 0;

			/* The counters are cleared by the read itself, so what came back
			 * is the traffic since the previous call: the rate is simply
			 * value/dt.  Differencing two reads (the previous approach)
			 * always produced zero, because the previous read had already
			 * consumed the counters. */
			let window = last && dt > 0.05 && dt < 10;

			let queues = {};
			let total = { packets: 0, bytes: 0, bps: 0, pps: 0 };

			for (let q in hq) {
				let g = hq[q];
				queues[q] = {
					packets: g.packets,
					bytes: g.bytes,
					bps: window ? int(g.bytes * 8 / dt) : 0,
					pps: window ? int(g.packets / dt) : 0
				};
				total.packets += g.packets;
				total.bytes += g.bytes;
				total.bps += queues[q].bps;
				total.pps += queues[q].pps;
			}

			last = { time: now };

			let layout = layout_info();
			let entries = parse_map();

			return {
				queues: queues,
				total: total,
				has_counters: has_counters,
				interval: window ? dt : 0,
				pool: pool_usage(layout, entries)
			};
		}
	}
};

return { 'luci.eqosex': methods };
