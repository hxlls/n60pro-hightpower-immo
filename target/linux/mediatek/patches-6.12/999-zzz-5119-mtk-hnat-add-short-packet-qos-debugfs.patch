hnat: add short-packet QoS debugfs knobs

Add short_pkt_toggle / short_pkt_qid / short_pkt_len debugfs nodes
under /sys/kernel/debug/hnat so userspace can enable per-flow short
packet detection and select the target hardware queue.

Also fix hnat_qos_toggle_read to print the value via seq_printf
instead of pr_info so `cat qos_toggle` works, and include the entry
qid in the all_entry dump for easier debugging.

Export the queue-index mask as HNAT_QDMA_QUEUE_MASK instead of relying
on MTK_QDMA_QUEUE_MASK: the latter is redefined per kernel series (the
64-queue patch turns it into GENMASK(15, 0), other series expand it to
a per-SoC expression that needs `eth` in scope), and neither variant
still describes the queue bits, so classifying flows with it silently
stops matching.

Whenever one of the three knobs is changed to a different value, drop
the already bound entries via foe_clear_all_bind_entries(): a bound
flow keeps the queue id stored in its PPE entry and is then forwarded
by the hardware, so the kernel never runs the classification path for
it again and the new value looks like it had no effect.

Signed-off-by: hxlls <hxlls@users.noreply.github.com>
---

diff --git a/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h b/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h
index 8d7f83c..a8152f7 100644
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h
@@ -1535,6 +1535,19 @@ extern int qos_toggle;
 extern int l2br_toggle;
 extern int l4s_toggle;
 extern int tnl_toggle;
+/* The QDMA queue index carried in skb->mark, mirroring how mtk_eth_soc
+ * hands the queue hint to the HNAT hardware.  It must NOT be expressed
+ * via MTK_QDMA_QUEUE_MASK: that macro is redefined between kernel
+ * series (here it becomes GENMASK(15, 0) after the 64-queue change, and
+ * elsewhere expands to a per-SoC expression that needs 'eth' in scope).
+ * Either variant silently defeats the classification below, and once
+ * HNAT takes over the flow the kernel never sees these packets again.
+ */
+#define HNAT_QDMA_QUEUE_MASK		0x3f
+
+extern int short_pkt_toggle;
+extern int short_pkt_qid;
+extern int short_pkt_len;
 extern int (*mtk_tnl_encap_offload)(struct sk_buff *skb, struct ethhdr *eth);
 extern int (*mtk_tnl_decap_offload)(struct sk_buff *skb);
 extern bool (*mtk_tnl_decap_offloadable)(struct sk_buff *skb);
diff --git a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c
index b81fddf..97ffd1f 100644
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c
@@ -44,6 +44,9 @@ int tnl_toggle;
 int xlat_toggle;
 int l2br_toggle;
 int l4s_toggle;
+int short_pkt_toggle;
+int short_pkt_qid = 14;
+int short_pkt_len = 64;
 struct hnat_desc headroom[DEF_ETRY_NUM];
 unsigned int dbg_cpu_reason_cnt[MAX_CRSN_NUM];
 
@@ -1938,14 +1941,15 @@ static void dbg_dump_entry(struct seq_file *m, struct foe_entry *entry,
 
 	if (IS_IPV4_HNAPT(entry)) {
 		seq_printf(m,
-			   "NAPT(%d): %pI4:%d->%pI4:%d => %pI4:%d->%pI4:%d\n",
+			   "NAPT(%d): %pI4:%d->%pI4:%d => %pI4:%d->%pI4:%d qid=%d\n",
 			   index, &saddr, entry->ipv4_hnapt.sport, &daddr,
 			   entry->ipv4_hnapt.dport, &nsaddr,
 			   entry->ipv4_hnapt.new_sport, &ndaddr,
-			   entry->ipv4_hnapt.new_dport);
+			   entry->ipv4_hnapt.new_dport, entry->ipv4_hnapt.iblk2.qid);
 	} else if (IS_IPV4_HNAT(entry)) {
-		seq_printf(m, "NAT(%d): %pI4->%pI4 => %pI4->%pI4\n",
-			   index, &saddr, &daddr, &nsaddr, &ndaddr);
+		seq_printf(m, "NAT(%d): %pI4->%pI4 => %pI4->%pI4 qid=%d\n",
+			   index, &saddr, &daddr, &nsaddr, &ndaddr,
+			   entry->ipv4_hnapt.iblk2.qid);
 	}
 
 	if (IS_IPV4_DSLITE(entry)) {
@@ -2800,6 +2804,54 @@ static const struct file_operations hnat_ppd_if_fops = {
 	.release = single_release,
 };
 
+#define DEFINE_HNAT_INT_DEBUGFS(name, var)					\
+static int hnat_##name##_read(struct seq_file *m, void *private)		\
+{										\
+	seq_printf(m, "%d\n", var);						\
+	return 0;								\
+}										\
+static int hnat_##name##_open(struct inode *inode, struct file *file)		\
+{										\
+	return single_open(file, hnat_##name##_read, file->private_data);	\
+}										\
+static ssize_t hnat_##name##_write(struct file *file, const char __user *buffer, \
+				   size_t count, loff_t *data)			\
+{										\
+	char buf[16] = {0};							\
+	long val;								\
+										\
+	if (count >= sizeof(buf) || copy_from_user(buf, buffer, count))		\
+		return -EFAULT;							\
+										\
+	if (kstrtol(buf, 0, &val))						\
+		return -EINVAL;							\
+										\
+	if (var != (int)val) {						\
+		var = val;							\
+		/* Already bound flows keep the queue id stored in their PPE\
+		 * entry: once an entry is written the hardware forwards those\
+		 * packets itself and the kernel never runs this classification\
+		 * again, so drop the bindings to make the new value apply.\
+		 */\
+		foe_clear_all_bind_entries();						\
+	}								\
+									\
+	pr_info("hnat " #name " = %ld\n", val);					\
+	return count;								\
+}										\
+static const struct file_operations hnat_##name##_fops = {			\
+	.open = hnat_##name##_open,						\
+	.read = seq_read,							\
+	.llseek = seq_lseek,							\
+	.write = hnat_##name##_write,						\
+	.release = single_release,						\
+};
+
+DEFINE_HNAT_INT_DEBUGFS(short_pkt_toggle, short_pkt_toggle)
+DEFINE_HNAT_INT_DEBUGFS(short_pkt_qid, short_pkt_qid)
+DEFINE_HNAT_INT_DEBUGFS(short_pkt_len, short_pkt_len)
+#undef DEFINE_HNAT_INT_DEBUGFS
+
 static int hnat_mape_toggle_read(struct seq_file *m, void *private)
 {
 	pr_info("value=%d, %s is enabled now!\n", mape_toggle, (mape_toggle) ? "mape" : "ds-lite");
@@ -3514,18 +3566,7 @@ static void hnat_qos_toggle_usage(void)
 
 static int hnat_qos_toggle_read(struct seq_file *m, void *private)
 {
-	if (qos_toggle == 0) {
-		pr_info("HQoS is disabled now!\n");
-	} else if (qos_toggle == 1) {
-		pr_info("HQoS is enabled now!\n");
-		pr_info("HQoS uplink is %s now!\n",
-				qos_ul_toggle ? "enabled" : "disabled");
-		pr_info("HQoS downlink is %s now!\n",
-				qos_dl_toggle ? "enabled" : "disabled");
-	} else if (qos_toggle == 2) {
-		pr_info("Per-port-per-queue mode is enabled!\n");
-	}
-
+	seq_printf(m, "%d\n", qos_toggle);
 	return 0;
 }
 
@@ -4383,6 +4424,13 @@ int hnat_init_debugfs(struct mtk_hnat *h)
 		debugfs_create_symlink(name, root, name_symlink);
 	}
 
+	debugfs_create_file("short_pkt_toggle", 0644, root, h,
+			    &hnat_short_pkt_toggle_fops);
+	debugfs_create_file("short_pkt_qid", 0644, root, h,
+			    &hnat_short_pkt_qid_fops);
+	debugfs_create_file("short_pkt_len", 0644, root, h,
+			    &hnat_short_pkt_len_fops);
+
 	return 0;
 
